# Server
PORT=3000

# Local Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# Separate Postgres database used by the tests
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/test_mydb?schema=public"

# Long random string used to sign JWTs
JWT_SECRET=

# Front-end origins allowed to call this API with cookies
AUTHOR_CLIENT=http://localhost:5173
PUBLIC_CLIENT=http://localhost:5174

# Requests allowed per IP in 15 minutes (defaults: 100 API, 10 auth)
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Cloudinary file uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
